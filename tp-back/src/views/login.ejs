<%- include("partials/head.ejs", { titulo: "Login" }) %>
<body>
    <header>
        <div class="marca">
            <img class="logo" src="/img/logo.jpg" alt="Logo de <%= app.nombre %>">
            <div>
                <h1><%= app.nombre %></h1>
                <small><%= app.alumnos %></small>
            </div>
        </div>
    </header>

    <main class="contenedor">
        <section class="form-caja">
            <h2>Ingreso de administrador</h2>
            <form id="form-login" class="form" action="/admin/login" method="POST">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" autocomplete="username">

                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" autocomplete="current-password">

                <p id="error" class="error" role="alert"><%= typeof error !== "undefined" ? error : "" %></p>

                <button type="submit" class="btn btn-primario btn-grande">Ingresar</button>
                <button type="button" id="btn-rapido" class="btn btn-sec">Acceso rápido</button>
                <a class="btn" href="/tienda/index.html">Volver al inicio</a>
            </form>
        </section>
    </main>

    <script>
        // Acceso rapido para los testers: autocompleta los inputs
        document.getElementById("btn-rapido").addEventListener("click", () => {
            document.getElementById("email").value = "admin@admin.com";
            document.getElementById("password").value = "admin123";
        });
    </script>
<%- include("partials/footer.ejs") %>
