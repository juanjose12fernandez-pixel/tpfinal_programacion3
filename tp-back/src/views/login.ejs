<%- include("partials/head.ejs", { titulo: "Login" }) %>
<body>
    <header>
        <div class="marca">
            <img class="logo" src="/img/logo.jpg" alt="Logo de <%= app.nombre %>">
            <div>
                <h1><%= app.nombre %></h1>
                <small><%= app.alumnos %></small>
            </div>
        </div>
    </header>

    <main class="contenedor">
        <section class="form-caja">
            <h2>Ingreso de administrador</h2>
            <form id="form-login" class="form" novalidate>
                <label for="email">Email</label>
                <input type="email" id="email" autocomplete="username">

                <label for="password">Contraseña</label>
                <input type="password" id="password" autocomplete="current-password">

                <p id="error" class="error" role="alert"></p>

                <button type="submit" class="btn btn-primario btn-grande">Ingresar</button>
                <button type="button" id="btn-rapido" class="btn btn-sec">Acceso rápido</button>
                <a class="btn" href="/tienda/index.html">Volver al inicio</a>
            </form>
        </section>
    </main>

    <script>
        const form = document.getElementById("form-login");
        const email = document.getElementById("email");
        const password = document.getElementById("password");
        const error = document.getElementById("error");

        // Acceso rapido para los testers: autocompleta los inputs
        document.getElementById("btn-rapido").addEventListener("click", () => {
            email.value = "admin@admin.com";
            password.value = "admin123";
        });

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            error.textContent = "";

            try {
                const respuesta = await fetch("/api/users/login", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ email: email.value.trim(), password: password.value })
                });
                const datos = await respuesta.json();

                if (!respuesta.ok) {
                    error.textContent = datos.listaErrores ? datos.listaErrores.join(". ") : datos.message;
                    return;
                }

                localStorage.setItem("admin", JSON.stringify(datos.payload));
                location.href = "/admin/dashboard";
            } catch (err) {
                error.textContent = "No se pudo conectar con el servidor";
            }
        });
    </script>
<%- include("partials/footer.ejs") %>
